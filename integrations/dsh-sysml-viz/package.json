{
  "name": "dsh-sysml-viz",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "DSH bundle: right-sidebar SysML model view (tree, structure/IBD/requirements/state diagrams, live modeling status, per-revision modeling-process timeline) plus the SysML v2 agent preset.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "preset-sysml-v2.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "install.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset-sysml-v2.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
